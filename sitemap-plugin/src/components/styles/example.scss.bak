/* PC / tablet: show the normal sitemap sidebar */
.sitemap-desktop {
  display: block;
}

/* Mobile menu is hidden by default */
.sitemap-mobile-menu {
  display: none;
}

/* Quartz mobile breakpoint */
@media all and (max-width: 800px) {
  /* Hide the normal sidebar */
  .sitemap-desktop {
    display: none;
  }

  /* Show the hamburger menu */
.sitemap-mobile-menu {
  display: block;
  position: fixed;
  top: 1rem;
  left: 1rem;
  right: auto;
  z-index: 1000;
}

  /* Hamburger button */
  .sitemap-menu-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.6rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .sitemap-menu-button::-webkit-details-marker {
    display: none;
  }

  /* Sitemap panel shown after tapping the button */
  .sitemap-menu-panel {
position: fixed;
top: 4rem;
left: 1rem;
right: auto;
    width: min(80vw, 320px);
    max-height: 75vh;
    overflow-y: auto;
    padding: 1rem;
    background: var(--light);
    border: 1px solid var(--lightgray);
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }
}